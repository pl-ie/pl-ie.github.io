#!/usr/bin/env bash
# yrp - download only those RSS episodes whose title contains a given phrase (p = phrase)
# Usage:
#   yrp                          ask for URL, phrase and speed
#   yrp -p "find phrase"         ask for URL and speed (phrase is given)
#   yrp -p "find phrase" -l 1M   ask only for URL
#   yrp -p "find phrase" -l 1M URL   no questions at all
#   yrp -p "" URL                all episodes (empty phrase)
# Options:
#   -p PHRASE   phrase to look for in the title (case-insensitive)
#   -l RATE     speed limit, e.g. 512K, 1M, 3M, 10M (0 = unlimited)
#   -h          show this help
# -p skips the phrase question, -l skips the speed question.
# Own files:
#   url-yrp.txt      - last feed URL
#   phrase-yrp.txt   - last phrase
#   archive-yrp.txt  - archive of downloaded IDs

C='\033[1;36m'
Y='\033[1;33m'
G='\033[1;32m'
B='\033[1;34m'
R='\033[0m'

GE=$'\033[1;32m'
YE=$'\033[1;33m'
RE=$'\033[0m'

URL_FILE="url-yrp.txt"
PHRASE_FILE="phrase-yrp.txt"
ARCHIVE_FILE="archive-yrp.txt"
MAX_RETRIES=5
SLEEP_BETWEEN=15
DEFAULT_RATE="512K"

usage() {
    cat <<'EOF'
Usage: yrp [-p "phrase"] [-l RATE] [URL]

  -p PHRASE   phrase to look for in the title (case-insensitive)
  -l RATE     speed limit, e.g. 512K, 1M, 3M, 10M (0 = unlimited)
  -h          show this help

Examples:
  yrp                          ask for URL, phrase and speed
  yrp -p "find phrase"         ask for URL and speed
  yrp -p "find phrase" -l 1M   ask only for URL
  yrp -p "find phrase" -l 1M URL   no questions at all
EOF
}

# === Options ===
PHRASE=""
PHRASE_SET=0
RATE_OPT=""
RATE_SET=0

while getopts ":p:l:h" opt; do
    case "$opt" in
        p) PHRASE="$OPTARG"; PHRASE_SET=1 ;;
        l) RATE_OPT="$OPTARG"; RATE_SET=1 ;;
        h) usage; exit 0 ;;
        :) printf "${Y}Error: option -%s requires an argument${R}\n" "$OPTARG"; exit 1 ;;
        \?) printf "${Y}Error: unknown option -%s${R}\n" "$OPTARG"; usage; exit 1 ;;
    esac
done
shift $((OPTIND-1))

printf "${B}=== YRP: podcasts from RSS filtered by a phrase in the title ===${R}\n\n"

# === URL ===
SAVED_URL=""
[ -f "$URL_FILE" ] && SAVED_URL=$(head -n1 "$URL_FILE")
# ignore a saved value that is not a valid URL (e.g. left by an older version)
case "$SAVED_URL" in
    http://*|https://*) ;;
    *) SAVED_URL="" ;;
esac

while true; do
    if [ -n "$1" ]; then
        URL="$1"
    else
        if [ -n "$SAVED_URL" ]; then
            printf "${Y}RSS feed URL${R} ${C}[Enter = $SAVED_URL]${R}\n"
        else
            printf "${Y}Enter RSS feed URL:${R}\n"
        fi
        printf "${G}> ${R}"
        read -r URL
        if [ -z "$URL" ] && [ -n "$SAVED_URL" ]; then
            URL="$SAVED_URL"
            printf "${C}Using saved URL:${R} ${Y}$URL${R}\n"
        fi
    fi
    case "$URL" in
        http://*|https://*) break ;;
    esac
    printf "${Y}Error: URL must start with http:// or https://${R}\n"
    # an invalid URL given as an argument cannot be re-asked
    [ -n "$1" ] && exit 1
done
echo "$URL" > "$URL_FILE"
echo ""

# === Phrase ===
SAVED_PHRASE=""
[ -f "$PHRASE_FILE" ] && SAVED_PHRASE=$(head -n1 "$PHRASE_FILE")

if [ "$PHRASE_SET" -eq 0 ]; then
    if [ -n "$SAVED_PHRASE" ]; then
        printf "${Y}Phrase to look for in the title${R} ${C}[Enter = $SAVED_PHRASE]${R}\n"
    else
        printf "${Y}Enter phrase to look for (empty = all episodes):${R}\n"
    fi
    printf "${G}> ${R}"
    read -r PHRASE
    [ -z "$PHRASE" ] && PHRASE="$SAVED_PHRASE"
fi
echo "$PHRASE" > "$PHRASE_FILE"

if [ -n "$PHRASE" ]; then
    printf "${C}Phrase:${R} ${Y}$PHRASE${R}\n"
else
    printf "${C}Phrase:${R} ${Y}none (all episodes)${R}\n"
fi
echo ""

# === Download speed ===
if [ "$RATE_SET" -eq 1 ]; then
    case "$RATE_OPT" in
        0|none) LIMIT_RATE="" ;;
        *)      LIMIT_RATE="$RATE_OPT" ;;
    esac
else
    printf "${C}╔════════════════════════════╗${R}\n"
    printf "${C}║${R}      ${Y}Download speed${R}        ${C}║${R}\n"
    printf "${C}╚════════════════════════════╝${R}\n"
    echo ""
    printf "${B}1)${R} 512K (default)  ${B}2)${R} 1M  ${B}3)${R} 3M\n"
    printf "${B}4)${R} 10M  ${B}5)${R} user kB  ${B}6)${R} none\n"
    printf "${G}> ${R}"
    read -r RATE_CHOICE

    case "$RATE_CHOICE" in
        2) LIMIT_RATE="1M" ;;
        3) LIMIT_RATE="3M" ;;
        4) LIMIT_RATE="10M" ;;
        5)
            printf "${Y}Enter limit in kB (e.g. 256):${R}\n"
            printf "${G}> ${R}"
            read -r USER_KB
            if [[ "$USER_KB" =~ ^[0-9]+$ ]] && [ "$USER_KB" -gt 0 ]; then
                LIMIT_RATE="${USER_KB}K"
            else
                printf "${Y}Invalid value, using default $DEFAULT_RATE${R}\n"
                LIMIT_RATE="$DEFAULT_RATE"
            fi
            ;;
        6) LIMIT_RATE="" ;;
        *) LIMIT_RATE="$DEFAULT_RATE" ;;
    esac
fi

if [ -n "$LIMIT_RATE" ]; then
    printf "${C}Limit:${R} ${Y}$LIMIT_RATE${R}\n"
    LIMIT_ARGS=(--limit-rate "$LIMIT_RATE")
else
    printf "${C}Limit:${R} ${Y}none${R}\n"
    LIMIT_ARGS=()
fi
echo ""

# === Scan local files: IDs from file names, any extension ===
touch "$ARCHIVE_FILE"
before=$(wc -l < "$ARCHIVE_FILE")

PREFIX=$(awk 'NF{print $1; exit}' "$ARCHIVE_FILE")
[ -z "$PREFIX" ] && PREFIX="generic"

printf "${C}Scanning local files for already downloaded episodes...${R}\n"
tmp=$(mktemp)
ids_file=$(mktemp)
shopt -s nullglob
local_count=0
for f in *.*; do
    case "$f" in
        *.part|*.ytdl|*.jpg|*.jpeg|*.png|*.webp|*.txt|*.sh) continue ;;
    esac
    ep_id=$(printf '%s' "$f" | sed -nE 's/.*\[([^][]+)\]\.[A-Za-z0-9]+$/\1/p')
    if [ -n "$ep_id" ]; then
        echo "$PREFIX $ep_id" >> "$tmp"
        echo "$ep_id" >> "$ids_file"
        local_count=$((local_count+1))
    fi
done
shopt -u nullglob

merged=$(mktemp)
cat "$ARCHIVE_FILE" "$tmp" | awk 'NF && !seen[$0]++' > "$merged"
mv "$merged" "$ARCHIVE_FILE"
rm -f "$tmp"

# === Filter: phrase in title (case-insensitive) & ID not yet on disk ===
FILTERS=()
if [ -n "$PHRASE" ]; then
    # strip \ and ', then escape regex special characters
    safe=$(printf '%s' "$PHRASE" | tr -d "\\\\'" | sed -E 's/[].[^$*+?(){}|]/\\&/g')
    [ -n "$safe" ] && FILTERS+=("title ~=? '(?i)${safe}'")
fi
if [ -s "$ids_file" ]; then
    re=$(grep -E '^[A-Za-z0-9_-]+$' "$ids_file" | sort -u | paste -sd'|')
    [ -n "$re" ] && FILTERS+=("id !~=? '^(${re})\$'")
fi
rm -f "$ids_file"

MATCH_ARGS=()
if [ ${#FILTERS[@]} -gt 0 ]; then
    FILTER=$(printf ' & %s' "${FILTERS[@]}")
    MATCH_ARGS=(--match-filters "${FILTER# & }")
fi

printf "${G}Files with ID on disk:${R} ${Y}$local_count${R}\n"
printf "${G}Archive entries:${R} ${Y}$(wc -l < "$ARCHIVE_FILE")${R}\n"
echo ""

printf "${C}──────────────────────────────${R}\n"
printf "${G}START${R}\n"
printf "${C}──────────────────────────────${R}\n"
echo ""

# === Download with retries ===
EXIT_CODE=1
for ((i=1; i<=MAX_RETRIES; i++)); do
    printf "${B}Attempt $i/$MAX_RETRIES...${R}\n"

    yt-dlp \
        -o "%(title)s [%(id)s].%(ext)s" \
        --download-archive "$ARCHIVE_FILE" \
        "${MATCH_ARGS[@]}" \
        "${LIMIT_ARGS[@]}" \
        --socket-timeout 30 \
        --retries 5 \
        --ignore-errors \
        --no-overwrites \
        --continue \
        -f "bestaudio/best" \
        --no-warnings \
        --progress \
        --newline \
        --print "before_dl:${GE}[%(playlist_index|?)s/%(n_entries|?)s]${RE} %(title).70s ${YE}[%(id)s]${RE}" \
        --no-quiet \
        --color always \
        "$URL" 2>&1 \
      | grep -v --line-buffered -E 'does not pass filter|has already been recorded|Downloading item [0-9]+ of'

    EXIT_CODE=${PIPESTATUS[0]}
    [ $EXIT_CODE -eq 0 ] && break

    printf "${Y}Error (code $EXIT_CODE). Waiting $SLEEP_BETWEEN s...${R}\n"
    sleep "$SLEEP_BETWEEN"
done

after=$(wc -l < "$ARCHIVE_FILE")
added=$((after - before))
[ $added -lt 0 ] && added=0

echo ""
printf "${C}──────────────────────────────${R}\n"
if [ $EXIT_CODE -eq 0 ]; then
    printf "${G}Finished successfully!${R}\n"
else
    printf "${Y}Finished with errors (code: $EXIT_CODE)${R}\n"
fi
printf "${B}New archive entries:${R} $added\n"
printf "${C}──────────────────────────────${R}\n"
